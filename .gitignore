# ── Rust ────────────────────────────────────────────────────────────────────
/target/
**/*.rs.bk
# Commit Cargo.lock for this binary application workspace.

# ── macOS / Xcode ───────────────────────────────────────────────────────────
# Generated by XcodeGen — regenerate with `just macos-gen`
platforms/macos/AgentCanvas.xcodeproj/

# Local team / signing (never commit personal Team IDs)
platforms/macos/Config/Local.xcconfig

platforms/macos/**/xcuserdata/
platforms/macos/**/*.xcuserstate
platforms/macos/DerivedData/
**/xcuserdata/
*.xcuserstate
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xccheckout
*.xcscmblueprint
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Local build products
/build/
*.app
*.appex

# ── App data / local previews (never ship user canvas data) ─────────────────
**/.velox/
**/previews/*.png
**/previews/*.token
**/previews/*.meta.json

# ── Secrets / env ───────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.p12
*.mobileprovision
# Sparkle EdDSA private key (public key may live in Info.plist later)
sparkle_private*
*.sparkle_private

